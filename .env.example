# Copy to .env and adjust. No secrets are needed for the local stack.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
TELEMETRY_TOPIC=telemetry
WORKORDER_TOPIC=workorders.cdc
LAKE_ROOT=./lake
# How long Spark keeps dedup state before it treats a reading as too late.
WATERMARK_DELAY=10 minutes
# Spark master; the docker-compose Spark container runs in local mode.
SPARK_MASTER=local[2]
